{
  "name": "pi-turbo",
  "version": "0.0.0",
  "private": true,
  "description": "System 1 decisions and scoped System 2 consultation for Pi Durable applications.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-durable",
    "pi-extension",
    "system1",
    "jev",
    "agent-runtime"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "files": [
    "src",
    "dist",
    "docs/development.md",
    "docs/evidence.md",
    "docs/releasing.md",
    "docs/durable-migration.md",
    "docs/v1-implementation.md",
    "docs/implementation-plan.md",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts",
    ".bun-version"
  ],
  "scripts": {
    "check": "bun node_modules/typescript/bin/tsc --noEmit",
    "build": "bun scripts/build.ts",
    "test": "bun run build && bun test",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check && bun run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/chord": "1.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/chord": "1.2.0",
    "typescript": "~5.9.3",
    "@types/bun": "1.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.3"
}
